{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "electron", "vite/client"]
  },
  "include": ["src", "test", "electron.vite.config.ts", "playwright.config.ts", "playwright.nonvisual.config.ts", "playwright.native-ime.config.ts"]
}
